# Set the default behavior, in case people don't have core.autocrlf set.
* text=auto

# Explicitly declare text files you want to always be normalized and converted
# to native line endings on checkout.
*.py text eol=lf
*.toml text eol=lf
*.md text eol=lf
*.yaml text eol=lf
*.json text eol=lf
*.lock text eol=lf

# Denote all binary files that should not be converted.
*.png binary
*.jpg binary
*.mp4 binary
*.mov binary
